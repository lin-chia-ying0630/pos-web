DB_USERNAME=pos
DB_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-root-password
WEB_PORT=8080
API_PORT=8081
MYSQL_PORT=3307
# 本機 build 可保留 local；部署時改成 Registry 完整名稱及不可變版本標籤。
POS_API_IMAGE=pos-api:local
POS_WEB_IMAGE=pos-web:local
SPRING_PROFILES_ACTIVE=prod
POS_SECURITY_ENABLED=true
POS_SECURITY_REQUIRE_HTTPS=true
POS_MAKER_USERNAME=maker
POS_MAKER_PASSWORD=replace-with-maker-password
POS_REVIEWER_USERNAME=reviewer
POS_REVIEWER_PASSWORD=replace-with-reviewer-password
POS_USER_USERNAME=user
POS_USER_PASSWORD=replace-with-user-password
POS_ADMIN_USERNAME=admin
POS_ADMIN_PASSWORD=replace-with-admin-password
